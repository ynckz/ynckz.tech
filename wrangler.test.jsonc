{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ynckz-tech-test",
  "compatibility_date": "2026-11-05",

  // Тестовый Worker для ветки feat/allo-cyr. Отдельное имя нужно, чтобы
  // деплой из ветки не трогал маршруты боевого ynckz-tech.
  "assets": {
    "directory": "./public",
  },

  // Только test.ynckz.tech: workers.dev выключен.
  "routes": [
    {
      "pattern": "test.ynckz.tech",
      "custom_domain": true,
    },
  ],

  "workers_dev": false,

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
